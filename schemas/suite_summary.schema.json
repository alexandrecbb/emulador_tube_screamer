{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "suite_summary.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "manifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "rates_Hz": {
      "const": [
        192000,
        384000
      ]
    },
    "completion": {
      "enum": [
        "incomplete",
        "completed",
        "failed"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "physical_case_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rate_Hz": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "case": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "run": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "nominal": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "refined": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "report": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_evaluated"
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "physical_case_sha256",
          "rate_Hz",
          "case",
          "run",
          "nominal",
          "refined",
          "report",
          "status",
          "exit_code",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "outcomes": {
      "type": "object",
      "properties": {
        "reference": {
          "enum": [
            "passed",
            "failed",
            "pending",
            "not_applicable"
          ]
        },
        "numerical": {
          "enum": [
            "passed",
            "failed",
            "pending",
            "not_applicable"
          ]
        },
        "wav": {
          "enum": [
            "passed",
            "failed",
            "pending",
            "not_applicable"
          ]
        },
        "listening": {
          "enum": [
            "passed",
            "failed",
            "pending",
            "not_applicable"
          ]
        },
        "combined": {
          "enum": [
            "passed",
            "failed",
            "pending",
            "not_applicable"
          ]
        }
      },
      "required": [
        "reference",
        "numerical",
        "wav",
        "listening",
        "combined"
      ],
      "additionalProperties": false
    },
    "exit_code": {
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "suite_id",
    "manifest",
    "toolchain",
    "rates_Hz",
    "completion",
    "entries",
    "outcomes",
    "exit_code"
  ],
  "additionalProperties": false
}
