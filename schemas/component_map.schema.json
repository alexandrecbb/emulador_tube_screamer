  "required": [
    "schema_version",
    "model_id",
    "source",
    "known_nodes",
    "components",
    "device_parameters",
    "controls",
    "extraction",
    "trace_map"
  ],
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "resistor",
            "capacitor",
            "potentiometer",
            "npn",
            "diode",
            "opamp"
          ]
        },
        "terminals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true
        },
        "value_SI": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "Ohm",
            "F"
          ]
        },
        "law": {
          "enum": [
            "diode_25c",
            "bjt_25c",
            "opamp_25c"
          ]
        },
        "owner": {
          "enum": [
            "input",
            "clipping",
            "tone_volume",
            "output",
            "fixture",
            "bias"
          ]
        },
        "provenance": {
          "enum": [
            "case_fixture",
            "schematic_transcription",
            "approved_reduced_model",
            "conditional_static_equivalent"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "terminals",
        "owner",
        "provenance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "resistor",
                  "capacitor",
                  "potentiometer"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value_SI",
              "unit"
            ],
            "not": {
              "required": [
                "law"
              ]
            }
          },
          "else": {
            "required": [
              "law"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value_SI"
                  ]
                },
                {
                  "required": [
                    "unit"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "capacitor"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "F"
              }
            }
          },
          "else": {
            "properties": {
              "unit": {
                "const": "Ohm"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "resistor"
              }
            }
          },
          "then": {
            "properties": {
              "terminals": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "capacitor"
              }
            }
          },
          "then": {
            "properties": {
              "terminals": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "npn"
              }
            }
          },
          "then": {
            "properties": {
              "terminals": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "diode"
              }
            }
          },
          "then": {
            "properties": {
              "terminals": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "opamp"
              }
            }
          },
          "then": {
            "properties": {
              "terminals": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "potentiometer"
              }
            }
          },
          "then": {
            "if": {
              "properties": {
                "id": {
                  "const": "P_drive"
                }
              }
            },
            "then": {
              "properties": {
                "terminals": {
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "else": {
              "properties": {
                "terminals": {
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "npn"
              }
            }
          },
          "then": {
            "properties": {
              "law": {
                "const": "bjt_25c"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "diode"
              }
            }
          },
          "then": {
            "properties": {
              "law": {
                "const": "diode_25c"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "opamp"
              }
            }
          },
          "then": {
            "properties": {
              "law": {
                "const": "opamp_25c"
              }
            }
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "properties": {
        "total_Ohm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum": {
          "const": 0
        },
        "maximum": {
          "const": 1
        },
        "coordinate": {
          "const": "resistance_track_fraction"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "current_id": {
                "type": "string",
                "minLength": 1
              },
              "terminals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "factor": {
                "enum": [
                  "fraction",
                  "1-fraction"
                ]
              }
            },
            "required": [
              "current_id",
              "terminals",
              "factor"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 2
        },
        "endpoint_equation": {
          "const": "v_a-v_b-R*i=0"
        }
      },
      "required": [
        "total_Ohm",
        "minimum",
        "maximum",
        "coordinate",
        "segments",
        "endpoint_equation"
      ],
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "zero_resistance_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "V",
            "A"
          ]
        },
        "orientation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "expression",
        "zero_resistance_expression",
        "unit",
        "orientation"
      ],
      "additionalProperties": false
    }
  }
}
