{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "failure.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "physical_case_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "failed_sample_index": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "failed_time_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_valid_state_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "backward_error": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "available",
            "value"
          ],
          "additionalProperties": false
        },
        "block": {
          "type": "integer"
        },
        "increment_norm": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "available",
            "value"
          ],
          "additionalProperties": false
        },
        "iterations": {
          "type": "integer"
        },
        "rank": {
          "type": "integer"
        },
        "rcond": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "available",
            "value"
          ],
          "additionalProperties": false
        },
        "reason": {
          "type": "string"
        },
        "residual_norm": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "available",
            "value"
          ],
          "additionalProperties": false
        },
        "row": {
          "type": "integer"
        },
        "trials": {
          "type": "integer"
        },
        "wet_switch_voltage_max_abs_V": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "coverage": {
              "type": "string"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "available",
            "coverage",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "backward_error",
        "block",
        "increment_norm",
        "iterations",
        "rank",
        "rcond",
        "reason",
        "residual_norm",
        "row",
        "trials",
        "wet_switch_voltage_max_abs_V"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "physical_case_sha256",
    "stage",
    "reason",
    "failed_sample_index",
    "failed_time_s",
    "last_valid_state_id",
    "diagnostics"
  ],
  "additionalProperties": false
}